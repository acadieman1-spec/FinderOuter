# ---------------------------------------------------------------------------
# CHROMAFIELD mint site — environment overrides (all optional).
# Copy to `.env.local`. Anything left unset falls back to src/config.ts.
# ---------------------------------------------------------------------------

# Program (contract) address for the network you are targeting.
# Leave as "demo" to run the whole site in Demo Mode with a simulated wallet.
VITE_PROGRAM_ID=demo
VITE_COLLECTION_AUTHORITY=6XDtMkSM1EjvwWkn5nH5JNSN3VW24THrUchDQiFinfBV
VITE_TREASURY=5MtUTGRrZtmc7ApJsDfHevdzW8faZPZHJ3wki6bLswM2

# devnet | mainnet-beta | localnet
VITE_NETWORK=devnet

# Optional custom RPC (useful for mainnet rate limits).
VITE_RPC_URL=

# Price in SOL and hard cap. The on-chain Collection account is authoritative
# in live mode; these are used for display and for Demo Mode.
VITE_PRICE_SOL=0.35
VITE_MAX_SUPPLY=2048
