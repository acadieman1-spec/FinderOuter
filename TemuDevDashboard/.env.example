# Copy to .env and fill in what you have. Everything here is optional:
# with no configuration at all the dashboard runs on the "mock" adapter.

# ---- data source -----------------------------------------------------------
# mock    = synthetic data through the real signing/envelope path (no network)
# partner = live calls to the Temu Partner API (needs the three credentials)
# csv     = affiliate/partner export that you paste into the Import tab
TEMU_ADAPTER=mock

# ---- region host -----------------------------------------------------------
# US     -> https://openapi-b-us.temu.com/openapi/router
# EU     -> https://openapi-b-eu.temu.com/openapi/router
# GLOBAL -> https://openapi-b-global.temu.com/openapi/router
TEMU_REGION=US

# ---- credentials (Partner Platform app) ------------------------------------
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_MALL_ID=

# ---- behaviour -------------------------------------------------------------
TEMU_QPS=20                  # documented default quota per app_key
TEMU_MAX_RETRIES=3
TEMU_TIMEOUT_MS=15000
TEMU_COMMISSION_RATE=10      # projection only: settlement x rate, clearly labelled
REPORT_CACHE_MS=60000        # don't burn quota on browser refreshes
TEMU_MOCK_SECRET=mock_app_secret_0001

# ---- server ----------------------------------------------------------------
PORT=4173
HOST=0.0.0.0                 # 127.0.0.1 if you don't want it on the LAN
DATA_DIR=./data

# ---- secrets on disk -------------------------------------------------------
# 0 (default) keeps app_secret/access_token in memory only.
# 1 writes them to data/settings.json so the dashboard survives restarts.
ALLOW_SECRET_PERSIST=0
